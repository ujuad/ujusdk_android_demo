<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 设置边框颜色和宽度 -->
    <stroke
        android:width="2dp"
        android:color="#FF0000" />  <!-- 红色边框 -->
    <!-- 设置圆角，不需要可以去掉 -->
    <corners android:radius="4dp" />
    <!-- 设置背景色，透明或按需 -->
    <solid android:color="#00000000" />  <!-- 透明背景 -->
</shape>